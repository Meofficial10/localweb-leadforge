# ---- Copy to .env ----
# App
APP_NAME=LeadForge
APP_ENV=develop
SECRET_KEY=change-me-to-a-long-random-string
AUTH_TOKENS=dev-token-123
DATABASE_URL=sqlite:///data/leadforge.db
LOG_LEVEL=INFO

# Default safety (never silently change these in prod)
DEFAULT_MODE=dry_run
FORCE_DRY_RUN=true  # keep true unless user explicitly opts into LIVE per channel

# Email (free tier options)
EMAIL_PROVIDER=smtp          # smtp | brevo | resend | file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=LeadForge Demo
EMAIL_FROM_ADDR=hello@examplesend.com
EMAIL_REPLY_TO=
SENDER_PHYSICAL_ADDRESS=123 Orchard Road, Singapore

# Voice (DRY-RUN by default)
VOICE_PROVIDER=mock          # mock | vapi | retell | bland
VOICE_DRY_RUN=true

# Lead sources
PLACES_API_KEY=
OSM_ENABLED=true

# LLM
LLM_PROVIDER=ollama          # mock | ollama | openai | anthropic
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Compliance
DNC_PROVIDER=none            # none (configurable adapter)
CALL_HOURS_WINDOW=10:00-18:00
CALL_DAYS=mon,tue,wed,thu,fri
BOUNCE_RATE_PAUSE_THRESHOLD=0.05
SPAM_COMPLAINT_PAUSE_THRESHOLD=0.001
DAILY_EMAIL_CAP=20
DAILY_CALL_CAP=10
WARMUP_START_DAILY=5
